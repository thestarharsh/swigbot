# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# Random string; Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change-me-to-a-random-string

# ── LLM (BYOK - pick ONE provider) ──────────────────────────────────────
# anthropic | openai | openrouter | gemini | custom
LLM_PROVIDER=anthropic
# Defaults per provider: claude-opus-4-8 | gpt-5.2 | anthropic/claude-sonnet-5
# (openrouter) | gemini-2.5-pro. Cheaper Anthropic options: claude-sonnet-5,
# claude-haiku-4-5.
LLM_MODEL=claude-opus-4-8
# Generic key used for the selected provider. Provider-specific keys below
# take precedence if set.
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Only for LLM_PROVIDER=custom: any OpenAI-compatible endpoint
LLM_BASE_URL=

# ── Database ────────────────────────────────────────────────────────────
# docker compose up -d  →  Postgres on localhost:5433
DATABASE_URL=postgresql://swigbot:swigbot@localhost:5433/swigbot

# ── App ─────────────────────────────────────────────────────────────────
# Public URL of this app. For Telegram testing use your ngrok HTTPS URL;
# the Swiggy OAuth redirect_uri is derived from this as
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback/swiggy
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Swiggy MCP ──────────────────────────────────────────────────────────
# No client id/secret needed: the app self-registers via Dynamic Client
# Registration (POST /auth/register) on first use and persists the result.
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
