# ── Telegram ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC-your-botfather-token
# Random string; Telegram echoes it back in X-Telegram-Bot-Api-Secret-Token
WEBHOOK_SECRET=change-me-to-a-random-string

# ── LLM (BYOK - pick ONE provider) ──────────────────────────────────────
# anthropic | openai | openrouter | gemini | custom
LLM_PROVIDER=anthropic
# Defaults per provider: claude-opus-4-8 | gpt-5.2 | anthropic/claude-sonnet-5
# (openrouter) | gemini-2.5-pro. Cheaper Anthropic options: claude-sonnet-5,
# claude-haiku-4-5.
LLM_MODEL=claude-opus-4-8
# Generic key used for the selected provider. Provider-specific keys below
# take precedence if set.
LLM_API_KEY=
# OpenRouter only: comma-separated models it may fail over to when the primary
# is rate-limited. Essential on the free tier, where pools saturate.
LLM_MODEL_FALLBACKS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Only for LLM_PROVIDER=custom: any OpenAI-compatible endpoint
LLM_BASE_URL=

# ── Database ────────────────────────────────────────────────────────────
# Neon: use the DIRECT connection string (host has NO "-pooler"). The pooled
# endpoint shares server connections, so a stray `SET search_path` from any
# client breaks unqualified queries, and it rejects `options=-c search_path`.
# TLS is applied automatically to any non-localhost host.
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full
# Used by drizzle-kit for DDL. Must be a direct (unpooled) endpoint.
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=verify-full
# Connections per instance. Defaults to 10 locally, 1 on Vercel.
# DB_POOL_MAX=

# ── App ─────────────────────────────────────────────────────────────────
# Public URL of this app. For Telegram testing use your ngrok HTTPS URL;
# the Swiggy OAuth redirect_uri is derived from this as
# ${NEXT_PUBLIC_APP_URL}/api/auth/callback/swiggy
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Base for the OAuth redirect_uri, when it must differ from the public app URL.
# Swiggy allowlists redirect URIs by exact match and accepts only HTTPS or
# http://localhost, so tunnel hostnames (ngrok, trycloudflare) are rejected at
# /authorize. With Telegram on a tunnel, keep this at http://localhost:3000 and
# open the login link in a browser on the machine running the app.
SWIGGY_REDIRECT_BASE_URL=http://localhost:3000

# ── Swiggy MCP ──────────────────────────────────────────────────────────
# No client id/secret needed: the app self-registers via Dynamic Client
# Registration (POST /auth/register) on first use and persists the result.
SWIGGY_MCP_BASE_URL=https://mcp.swiggy.com
